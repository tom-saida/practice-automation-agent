    {"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"name","value":"ortho_practice_facts"},"returnAll":true},"id":"4da776e5-ab27-48c9-b96b-ac0c6f567adc","name":"Ctx Practice Facts","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[860,1440],"alwaysOutputData":true,"executeOnce":true},
    {"parameters":{"jsCode":"const q = $('Admin Command Parse').first().json.question || '';\nconst rows = (name) => { try { return $(name).all().map(i => i.json); } catch (e) { return []; } };\nconst facts = rows('Ctx Practice Facts').filter(r => r.key).map(r => (r.category ? ('[' + r.category + '] ') : '') + r.key + ': ' + r.value).join('\\n') || 'none';\nconst convs = rows('Ctx Conversations').filter(r => r.phone).slice(0, 15).map(r => r.phone + ' state=' + r.state + ' type=' + (r.patient_type || '-') + ' last=\"' + ((r.last_message || '').slice(0, 60)) + '\" upd=' + (r.updated_at || '')).join('\\n') || 'none';\nconst queue = rows('Ctx Queue').filter(r => r.phone && r.status === 'open').slice(0, 15).map(r => r.phone + ' [' + r.reason + '] \"' + ((r.context || '').slice(0, 70)) + '\" ' + (r.created_at || '')).join('\\n') || 'empty';\nconst events = rows('Ctx Events').filter(r => r.event).slice(0, 30).map(r => (r.at || '') + ' ' + r.event + ' ' + (r.phone || '') + ' ' + ((r.detail || '').slice(0, 60))).join('\\n') || 'none';\nconst slots = rows('Ctx Slots').filter(r => r.slot_label).map(r => r.slot_label + ' ' + (r.taken ? ('TAKEN by ' + (r.booked_by || '?')) : 'open')).join('\\n') || 'none';\nconst prompt = 'You are the admin assistant for this practice, replying to the practice owner by SMS. Answer using ONLY the data below. Be specific and brief (under 450 characters), plain text, no markdown. If the data cannot answer, say so and name what is missing. Never invent patients, numbers, fees, or events.\\n\\nOWNER QUESTION: ' + q + '\\n\\nPRACTICE FACTS (identity, hours, insurance, fees, policies):\\n' + facts + '\\n\\nOPEN CALLBACK QUEUE:\\n' + queue + '\\n\\nCONVERSATIONS:\\n' + convs + '\\n\\nRECENT EVENTS (newest first):\\n' + events + '\\n\\nCONSULT SLOTS:\\n' + slots;\nreturn [{ json: { question: q, prompt } }];"},"id":"c5c462c6-af96-41ed-92bd-ac15fe2461a9","name":"Assemble Admin Context","type":"n8n-nodes-base.code","typeVersion":2,"position":[864,1280]},
    {"parameters":{"model":{"__rl":true,"mode":"id","value":"qwen3.6-35b-a3b-mlx"},"responsesApiEnabled":false,"options":{"temperature":0.2,"timeout":45000,"maxRetries":1}},"id":"1df07a09-2348-4b0e-b7dd-c7f40bfe863e","name":"Admin Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[1024,1440]},
