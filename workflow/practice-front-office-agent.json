    {"parameters":{"jsCode":"const slots = $input.all().map(i => i.json).filter(r => r.slot_label);\nconst phone = $(\"Normalize Inbound\").first().json.phone;\nif (!slots.length) {\n  return [{ json: { has_slots: false, phone } }];\n}\nconst top = slots.slice(0, 2);\nconst lines = top.map((s, ix) => (ix + 1) + \") \" + s.slot_label).join(\"   \");\nreturn [{ json: {\n  has_slots: true,\n  phone,\n  offered_slots: top.map(s => s.slot_label).join(\"|\"),\n  sms_text: \"Great news - we have consult openings: \" + lines + \". Reply 1 or 2 to grab one, or reply with a day that works better.\",\n  event: \"offer_sent\"\n} }];"},"id":"25444fce-7865-485c-bcca-d8d905e5a72e","name":"Compose Slot Offer","type":"n8n-nodes-base.code","typeVersion":2,"position":[624,144]},
