    {"parameters":{"jsCode":"const conv = $(\"Load Conversation\").first().json;\nconst text = ($(\"Normalize Inbound\").first().json.text || \"\").trim().toLowerCase();\nconst offered = (conv.offered_slots || \"\").split(\"|\").filter(Boolean);\nlet slot = null;\nif (/^1\\b/.test(text) && offered[0]) { slot = offered[0]; }\nelse if (/^2\\b/.test(text) && offered[1]) { slot = offered[1]; }\nelse { slot = offered.find(s => text.includes(s.toLowerCase())) || null; }\nreturn [{ json: { matched: !!slot, slot_label: slot || \"\", phone: conv.phone } }];"},"id":"907cf9e9-93d0-4fde-811a-6fa9169b9de7","name":"Parse Slot Choice","type":"n8n-nodes-base.code","typeVersion":2,"position":[144,704]},
