    {"parameters":{"jsCode":"const t = ($('Normalize Inbound').first().json.text || '').trim();\nconst m = t.match(/^(?:text|send|msg)\\s+(\\+?[\\d\\-\\s().]{8,})\\s*[:\\-]\\s*(.+)$/i);\nif (m) {\n  const to = '+' + m[1].replace(/[^\\d]/g, '');\n  return [{ json: { mode: 'relay', to, message: m[2].trim() } }];\n}\nreturn [{ json: { mode: 'ask', question: t } }];"},"id":"2b31eba7-bb33-4ad2-9171-e954509ed035","name":"Admin Command Parse","type":"n8n-nodes-base.code","typeVersion":2,"position":[-304,1168]},
